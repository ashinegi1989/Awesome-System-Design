import time

def is_rate_limited(user_id, limit=100, window_size_seconds=60):
    current_time = time.time()
    clear_before_time = current_time - window_size_seconds
    
    # 1. Clear out-of-window requests from memory/Redis
    # Redis Command: ZREMRANGEBYSCORE user_id -inf clear_before_time
    redis_db.zremrangebyscore(user_id, '-inf', clear_before_time)
    
    # 2. Fetch total requests in the current sliding window
    # Redis Command: ZCARD user_id
    current_request_count = redis_db.zcard(user_id)
    
    if current_request_count < limit:
        # 3. Log the new valid request timestamp
        # Redis Command: ZADD user_id current_time current_time
        redis_db.zadd(user_id, {current_time: current_time})
        return False  # Request allowed
        
